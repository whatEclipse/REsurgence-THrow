[sub_resource type="GDScript" id="GDScript_6bivr"]
script/source = "extends Control

@onready var continue_button: Button =  $CenterContainer/VBoxContainer/PlayButton
@onready var level_select_button: Button = $CenterContainer/VBoxContainer/LevelSelectButton
@onready var quit_button: Button = $CenterContainer/VBoxContainer/QuitButton
@onready var sound_check_box: BaseButton = $SoundCheckBox

func _ready() -> void:
	continue_button.pressed.connect(_on_continue_pressed)
	level_select_button.pressed.connect(_on_level_select_pressed)
	quit_button.pressed.connect(_on_quit_pressed)

	sound_check_box.button_pressed = AudioManager.sound_enabled
	sound_check_box.toggled.connect(AudioManager.set_sound_enabled)

	continue_button.grab_focus() 

func _on_continue_pressed() -> void:
	GameData.play_level(GameData.last_level)

func _on_level_select_pressed() -> void:
	get_tree().change_scene_to_file(GameData.LEVEL_SELECT_PATH)

func _on_quit_pressed() -> void:
	get_tree().quit()
"

